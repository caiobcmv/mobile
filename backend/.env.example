# URL de conexão do PostgreSQL (usada para Neon, Render, etc.)
# Se definida, as outras variáveis de DB (DB_HOST, etc.) serão ignoradas.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=atividades_complementares_senac
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
JWT_SECRET=sua_chave_secreta_longa_aqui
